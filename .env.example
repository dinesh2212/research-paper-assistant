APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
DATABASE_URL=sqlite+aiosqlite:///./data/research_paper_assistant.db
PAPER_STORAGE_PATH=./data/papers
MAX_PDF_SIZE_BYTES=52428800
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=gemma4:12b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=16
INDEXING_TIMEOUT_SECONDS=120
QDRANT_COLLECTION=paper_chunks_qwen3_0_6b_v1
CHUNK_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
INGESTION_POLL_SECONDS=1
RETRIEVAL_DEBUG_ENABLED=false
HEALTH_TIMEOUT_SECONDS=3
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
